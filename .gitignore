# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt-specific
**/.terraform.lock.hcl
**/.terragrunt-cache/**
**/.terragrunt-module-manifest
**/.terragrunt-source-manifest
**/.terragrunt-source-version
**/.terragrunt-init-required
.terragrunt-module-manifest
.terragrunt-source-manifest
.terragrunt-source-version
.terragrunt-init-required

# Terraform plan output
*.tfplan
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc

# Ignore IDE files
.idea/
.vscode/

# Backup files created by text editors
*.bak
*~

# Environment files
.env
.env.local
.env.*

# Log files
*.log 

# Terragrunt rendered config (generated artifact)
**/terragrunt_rendered.json

# Go test binaries
*.test
__debug_bin*

# platctl
bin/
.platctl-logs/
.platctl-state.json

# Secrets (real values, gitignored — see secrets.hcl.example for structure)
**/secrets.hcl

# OS files
.DS_Store
**/.DS_Store