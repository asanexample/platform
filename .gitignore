# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt-specific
**/.terraform.lock.hcl
**/.terragrunt-cache/**
**/.terragrunt-module-manifest
**/.terragrunt-source-manifest
**/.terragrunt-source-version
**/.terragrunt-init-required
.terragrunt-module-manifest
.terragrunt-source-manifest
.terragrunt-source-version
.terragrunt-init-required

# Terraform plan output
*.tfplan
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc

# Ignore IDE files
.idea/
.vscode/

# Backup files created by text editors
*.bak
*~

# Environment files
.env
.env.local
.env.*

# Log files
*.log 

# Terragrunt rendered config (generated artifact)
**/terragrunt_rendered.json

# Go test binaries
*.test
__debug_bin*

# platctl
bin/
.platctl-logs/
.platctl-state.json

# Secrets — plaintext forms are gitignored; only the SOPS-encrypted secrets.enc.yaml is committed (ADR-066).
# secrets.hcl is kept locally as a DR copy + the source for re-encryption. See secrets.hcl.example for structure.
**/secrets.hcl
**/secrets.yaml

# Private keys / certs (e.g. downloaded GitHub App keys — store in Secrets Manager, never commit)
*.pem
*.key
*.p12

# platctl config (contains account IDs — see .platctl.yaml.example)
.platctl.yaml

# OS files
.DS_Store
**/.DS_Store

# Local tooling (not committed)
.claude/*
# ...except house-authored skills, which are committed and shared with the team.
# Transient/installed skills (speckit-*, etc.) stay ignored. Vendored third-party
# skills are the exception: a pinned, audited copy IS committed (see its
# PROVENANCE.md) so it's reviewable and doesn't silently auto-update. Add one
# negation line per house or vendored skill.
!.claude/skills/
.claude/skills/*
!.claude/skills/terraform-style/
!.claude/skills/authoring-k8s-workloads/
!.claude/skills/terragrunt-units/
!.claude/skills/platctl/
!.claude/skills/cluster-access/
!.claude/skills/cluster-parking/
!.claude/skills/apply-and-destroy/
!.claude/skills/authoring-adrs/
!.claude/skills/environment-onboarding/
!.claude/skills/supply-chain-onboarding/
!.claude/skills/skill-self-correction/
!.claude/skills/kyverno-policy-authoring/
!.claude/skills/crossplane-composition-authoring/
!.claude/skills/argocd-app-delivery/
!.claude/skills/observability-authoring/
!.claude/skills/backstage-portal/
!.claude/skills/authoring-platform-agents/
!.claude/skills/maintaining-docs/
!.claude/skills/triaging-issues/
!.claude/skills/learning-portal-diagrams/
# Vendored third-party skill (pinned + audited — see PROVENANCE.md):
!.claude/skills/terraform-skill/
# Shared team settings (MCP allow-list, hooks, etc.). The personal settings.local.json stays ignored.
!.claude/settings.json
# Committed Claude Code hook scripts (referenced from settings.json).
!.claude/hooks/
# Committed project slash commands.
!.claude/commands/
.specify/
# Infracost local cache (shift-left cost-in-PR; CI uses a fresh checkout)
.infracost/
