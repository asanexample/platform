{
  "enabledMcpjsonServers": ["grafana", "aws-api"],
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(tofu validate *)",
      "Bash(tofu fmt -check *)",
      "Bash(terragrunt hcl fmt --check *)",
      "mcp__grafana__query_prometheus",
      "mcp__grafana__query_loki_logs",
      "mcp__grafana__list_datasources",
      "mcp__grafana__alerting_manage_rules",
      "mcp__aws-api__call_aws",
      "mcp__aws-api__suggest_aws_commands"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-sensitive-edits.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
