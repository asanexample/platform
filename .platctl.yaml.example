environments:
  platform:
    path: infra/live/aws/platform/us-east-1/platform
    provider: aws
    auth:
      profile: management
  preprod:
    path: infra/live/aws/preprod/us-east-1/platform
    provider: aws
    auth:
      profile: management
    # After `platctl up --env preprod` restores the workload cluster, repair the platform→preprod path that a
    # park/restore (or an EKS control-plane ENI rotation) can leave stale: re-apply the platform cross-vpc-dns
    # unit (re-looks-up preprod's API ENIs → rewrites the PHZ; no-op if already correct) and bounce the platform
    # ArgoCD controller (clears its cached dead connection to the parked API). Makes the manual scale-up recovery
    # automatic — see reference_preprod_scaleup_recovery / docs/runbooks.
    reconnect:
      units:
        - { env: platform, unit: cross-vpc-dns }
      restarts:
        - { env: platform, namespace: argocd, target: statefulset/argocd-application-controller }
  # prod:
  #   path: infra/live/aws/prod/us-east-1/platform
  #   provider: aws
  #   auth:
  #     profile: management

overrides:
  # NOTE: the management bootstrap floor — state-bootstrap, state-access, and sops-kms (the ADR-066 config key) —
  # lives under infra/live/aws/mgmt/global/, OUTSIDE both env-teardown trees, so platctl never discovers or
  # destroys it (no teardown_skip needed; that's only for floor units WITHIN an env tree, like iam-roles below).
  platform/iam-roles:
    auth:
      profile: platform
    # Bootstrap-tier: keep PlatformDeployer alive across teardown so the next bootstrap can assume it
    # (recreating it otherwise needs the break-glass OrganizationAccountAccessRole path,
    # scripts/bootstrap-iam-roles.sh). Like the state backend, teardown leaves this alone.
    teardown_skip: true

  preprod/iam-roles:
    auth:
      profile: preprod
    teardown_skip: true

  platform/agent-eval-store:
    # The agent-eval corpus is durable, built-forward, keep-forever data (ADR-080 D6): an incident not captured
    # when it fires is lost (can't backfill), and the corpus accrues the shadow→proven→promoted signal that
    # gates agent autonomy. Like the state backend and iam-roles, teardown leaves it alone so it survives a
    # rebuild (the bucket's force_destroy=false is the second guard against accidental deletion).
    teardown_skip: true

  platform/tailscale-admin:
    implicit_deps: ["preprod/iam-roles"]
    hook: secret_cleanup
    hook_config:
      profile: platform
      secrets: "platform/tailscale/oauth@platform,preprod/tailscale/oauth@preprod,preprod/tailscale/api-key@preprod"

  platform/argocd:
    # Post-apply: re-mint the read-only ArgoCD token that Backstage's ArgoCD plugin authenticates with. A
    # from-scratch rebuild regenerates the ArgoCD server signing key, which silently invalidates the token in
    # Secrets Manager (minted out-of-band) and blanks every Backstage ArgoCD card. argocd is an early wave, so
    # minting here lands a valid token in SM before backstage's ExternalSecret first syncs — no restart or ESO
    # force-refresh needed (which the operate-only PlatformAdmin can't do anyway). Idempotent (re-mints only when
    # the current token fails validation, so applies don't accumulate dead tokens); best-effort (warns on
    # failure, never fails bootstrap). See docs/runbooks/backstage-argocd.md.
    hook: argocd_account_token
    hook_config:
      cluster: platform-use1-eks
      region: us-east-1
      profile: platform # AWS profile for cluster access + the SM write
      role_arn: arn:aws:iam::<PLATFORM_ACCOUNT_ID>:role/PlatformAdmin
      account: backstage # the read-only ArgoCD local account
      namespace: argocd
      server_deploy: argocd-server
      secret_id: platform/argocd/backstage-token
      secret_key: token

  platform/eks:
    bootstrap_args: ["-var", "endpoint_public_access=true"]

  preprod/eks:
    bootstrap_args: ["-var", "endpoint_public_access=true"]

  # On teardown, drop the keycloak_* realm/client/mapper/group resources from state before destroy: they're
  # deleted granularly over a port-forward against a Keycloak that's destroyed wholesale (CNPG DB and all) in
  # the next wave, so the per-object DELETEs only time out. The realm content vanishes with the database.
  platform/keycloak-config:
    hook: state_purge
    hook_config:
      patterns: "keycloak_"

  platform/tailscale:
    hook: crd_two_stage
    hook_target: "helm_release.tailscale_operator[0]"
    bootstrap_args: ["-var", "split_dns={}"]
    # platform/tailscale READS platform/tailscale/oauth (a Secrets Manager data source) which tailscale-admin
    # CREATES and recreates via its secret_cleanup hook. Without this dep, a skipped/failed tailscale-admin lets
    # platform/tailscale race ahead and read a pending-deletion secret → "couldn't find resource". Mirrors
    # preprod/tailscale below (the ordering is usually masked because tailscale-admin's deps resolve far earlier).
    implicit_deps: ["platform/tailscale-admin"]

  preprod/tailscale:
    hook: crd_two_stage
    hook_target: "helm_release.tailscale_operator[0]"
    implicit_deps: ["platform/tailscale-admin"]

  platform/networking:
    implicit_deps: ["platform/iam-roles"]

  preprod/networking:
    implicit_deps: ["preprod/iam-roles"]

  platform/route53:
    implicit_deps: ["platform/iam-roles"]
    # Zones hold records (incl. external-dns-created ones); force_destroy to allow zone deletion on teardown.
    teardown_args: ["-var", "force_destroy=true"]

  preprod/route53:
    implicit_deps: ["preprod/iam-roles"]
    teardown_args: ["-var", "force_destroy=true"]

  platform/route53-delegation:
    implicit_deps: ["platform/route53", "preprod/route53"]

  # ECR repos hold images (Backstage, per-team app images); force_delete to allow deletion on teardown.
  platform/ecr:
    teardown_args: ["-var", "force_delete=true"]

  # Mimir's S3 metrics bucket holds objects; force_destroy to empty + delete it on teardown.
  platform/mimir:
    teardown_args: ["-var", "force_destroy=true"]

  preprod/cert-manager:
    hook: crd_two_stage
    hook_target: "helm_release.cert_manager[0]"

  platform/argocd-apps:
    implicit_deps: ["platform/argocd", "platform/argocd-clusters"]

  platform/cloudtrail:
    teardown_args: ["-var", "force_destroy=true"]
    implicit_deps: ["platform/iam-roles"]

  preprod/cloudtrail:
    teardown_args: ["-var", "force_destroy=true"]
    implicit_deps: ["preprod/iam-roles"]

  platform/cross-vpc-dns:
    hook: eni_ip_validation
    hook_config:
      cluster_name: preprod-use1-eks
      profile: management

manual_steps:
  - name: cloudflare-api-token
    before: platform/cloudflare-dns
    instructions: |
      Store Cloudflare API token in Secrets Manager:
        aws secretsmanager create-secret \
          --name platform/cloudflare/api-token \
          --secret-string '<TOKEN>' \
          --region us-east-1 --profile platform
    check:
      type: secret_exists
      secret_id: platform/cloudflare/api-token
      profile: platform

  - name: tailscale-api-key
    before: platform/tailscale-admin
    instructions: |
      1. Generate API key: Tailscale Admin -> Settings -> Keys
      2. Store in Secrets Manager:
        aws secretsmanager create-secret \
          --name platform/tailscale/api-key \
          --secret-string '<KEY>' \
          --region us-east-1 --profile platform
    check:
      type: secret_exists
      secret_id: platform/tailscale/api-key
      profile: platform

  # NB: no argocd-saml manual_step — ArgoCD SSO brokers through Keycloak OIDC now (ADR-053/059, Dex+SAML retired).
  # The OIDC client secret is provisioned by keycloak-config (an IaC unit ordered before argocd), so there is no
  # manual prerequisite for ArgoCD sign-in.

kubeconfig:
  - alias: platform
    cluster: platform-use1-eks
    region: us-east-1
    profile: platform
    kubectl_role_arn: arn:aws:iam::<PLATFORM_ACCOUNT_ID>:role/PlatformAdmin
  - alias: preprod
    cluster: preprod-use1-eks
    region: us-east-1
    profile: preprod
    kubectl_role_arn: arn:aws:iam::<PREPROD_ACCOUNT_ID>:role/PlatformAdmin

lockdown:
  # Tailscale split-DNS MUST run BEFORE the EKS endpoint-disable below. These units carry kubernetes_manifest
  # resources (proxy_class/connector) whose GroupVersionResource discovery hits the LIVE cluster API at PLAN
  # time — even though the only thing changing is the Tailscale-API split_dns resource. Once the public
  # endpoint is disabled the API is private-only and that plan-time discovery times out (the apply host isn't
  # on the tailnet — and configuring Tailscale is precisely what would put it there: a chicken-and-egg). The
  # split_dns value is the static VPC resolver (10.100.0.2), independent of the endpoint toggle, so enabling it
  # while the endpoint is still public is safe. No later lockdown step touches the cluster K8s API (eks +
  # cross-vpc-dns are AWS-provider ops), so split-DNS being live can't affect them.
  - unit: platform/tailscale
    description: Enable split DNS for private EKS resolution
  - unit: preprod/tailscale
    description: Enable split DNS for preprod.aws.refplat.org resolution
  - unit: platform/eks
    description: Disable public EKS endpoint
  - unit: preprod/eks
    description: Disable public EKS endpoint
  # MUST follow the EKS endpoint toggles: disabling public access churns the cluster API ENIs, leaving the
  # cross-vpc-dns PHZ A-record stale — ArgoCD (platform) then can't resolve/reach the preprod API and every
  # preprod-targeting Application degrades to Unknown/SyncFailed. Re-applying refreshes the dynamic ENI lookup.
  - unit: platform/cross-vpc-dns
    description: Refresh preprod EKS API PHZ records (ENIs churn on endpoint toggle)

validate:
  # NS / TGW-id / EKS-endpoint values CHURN on every rebuild, so validate DISCOVERS them (Route53 delegation
  # set, the account's TGW, the remote cluster's EKS endpoint). expected_ns / transit_gateway.id /
  # cross_vpc_dns.endpoint remain optional overrides.
  dns:
    zone: aws.refplat.org
    profile: platform # account owning the hosted zone (NS discovery)
  tailscale:
    vpc_cidrs:
      platform: "10.100.0.0/16"
      preprod: "10.101.0.0/16"
  gateway:
    name: platform-gateway
    namespace: default
    cert_name: platform-gateway-tls
  preprod_gateway:
    name: preprod-gateway
    namespace: default
    cert_name: preprod-gateway-tls
  endpoints:
    - name: argocd
      url: https://argocd.aws.refplat.org/
      env: platform
    - name: keycloak
      url: https://keycloak.aws.refplat.org/
      env: platform
    - name: grafana
      url: https://grafana.aws.refplat.org/
      env: platform
    - name: backstage
      url: https://backstage.aws.refplat.org/
      env: platform
  # Units whose EMPTY state is intentional — their state check passes instead of false-failing:
  # mimir is off in the cost-optimized dev profile; preprod gateway-config has no per-app routes (the
  # platform cluster hosts argocd/grafana/backstage routes; tenant routes ship in the app repos).
  expected_empty_units:
    - platform/mimir
    - preprod/gateway-config
  iam:
    state_bucket: tfstate-mgmt-<MGMT_ACCOUNT_ID>
    accounts:
      platform:
        id: "<PLATFORM_ACCOUNT_ID>"
        deployer_role_arn: arn:aws:iam::<PLATFORM_ACCOUNT_ID>:role/PlatformDeployer
      preprod:
        id: "<PREPROD_ACCOUNT_ID>"
        deployer_role_arn: arn:aws:iam::<PREPROD_ACCOUNT_ID>:role/PlatformDeployer
