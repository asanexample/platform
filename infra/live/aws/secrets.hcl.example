locals {
  # AWS account IDs
  account_ids = {
    mgmt     = "111111111111"
    platform = "222222222222"
    preprod  = "333333333333"
    prod     = "444444444444"
    test     = "555555555555"
  }

  # State backend
  state_bucket   = "tfstate-mgmt-111111111111"
  state_role_arn = "arn:aws:iam::111111111111:role/TerraformStateAccess"

  # Contact email (Let's Encrypt, CAA records, Identity Center)
  admin_email = "admin@example.com"

  # Account creation emails (Organizations module)
  account_emails = {
    platform = "admin+platform@example.com"
    test     = "admin+test@example.com"
    preprod  = "admin+preprod@example.com"
    prod     = "admin+prod@example.com"
  }

  # External service IDs
  cloudflare_zone_id = "your-cloudflare-zone-id"

  # ArgoCD SSO (Identity Center SAML)
  argocd_sso_url     = "https://your-sso-url"
  argocd_sso_ca_data = "base64-encoded-saml-certificate"

  # Dex SSO broker (Identity Center SAML) — a SEPARATE Identity Center SAML app from ArgoCD's
  # (ACS https://sso.aws.refplat.org/callback), so it has its own signing certificate.
  # Populate from the manual app setup in docs/runbooks/dex-sso.md.
  dex_sso_url     = "https://your-dex-sso-url"
  dex_sso_ca_data = "base64-encoded-saml-certificate"

  # Keycloak app-IdP broker (Identity Center SAML, ADR-053) — its OWN Identity Center SAML app
  # (ACS https://keycloak.aws.refplat.org/realms/platform/broker/aws-sso/endpoint), so its own cert.
  # NOTE: keycloak_sso_ca_data is the BARE base64 cert body (no PEM -----BEGIN/END----- headers/newlines),
  # unlike dex_sso_ca_data. Populate from docs/runbooks/keycloak-sso.md.
  keycloak_sso_url     = "https://your-keycloak-sso-url"
  keycloak_sso_ca_data = "base64-encoded-saml-certificate-body"

  # OIDC upstream (Okta/Entra/Google, ADR-059) — only when switching keycloak-config's `upstream.protocol` to
  # "oidc". Inert today (AWS IdC SAML is the upstream). See docs/runbooks/keycloak-upstream-idp.md.
  # keycloak_upstream_oidc_client_secret = "the-broker-app-client-secret"
}
