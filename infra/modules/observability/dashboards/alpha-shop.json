{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "alpha-shop",
    "product",
    "team-alpha",
    "red",
    "autoscaling",
    "progressive-delivery"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/Mimir.*/",
        "current": {
          "text": "Mimir (all clusters)",
          "value": "mimir-all"
        },
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "alpha-shop-dev",
        "current": {
          "text": "alpha-shop-dev",
          "value": "alpha-shop-dev"
        },
        "hide": 2,
        "label": "Namespace"
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "Alpha Shop \u2014 Product Overview",
  "uid": "alpha-shop-overview",
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 1
    },
    {
      "type": "stat",
      "title": "Pods running",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kube_pod_info{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Services (Rollouts)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (name)(rollout_phase{exported_namespace=\"$namespace\"}))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Storefront replicas (HPA)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"storefront\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Container restarts (1h)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pods by workload",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (created_by_name)(kube_pod_info{namespace=\"$namespace\",created_by_kind=\"ReplicaSet\"})",
          "legendFormat": "{{created_by_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Autoscaling (ADR-078)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Storefront replicas \u2014 HPA min / current / max",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "unit": "none"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"storefront\"}",
          "legendFormat": "current"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"storefront\"}",
          "legendFormat": "min"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"storefront\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storefront CPU utilization vs HPA target (60%)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container=\"storefront\"}[5m])) / sum(kube_pod_container_resource_requests{namespace=\"$namespace\",container=\"storefront\",resource=\"cpu\"})",
          "legendFormat": "CPU utilization %"
        }
      ]
    },
    {
      "type": "row",
      "title": "Progressive delivery (ADR-056)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "id": 20
    },
    {
      "type": "state-timeline",
      "title": "Rollout phase by service",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          },
          "mappings": []
        }
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(rollout_phase{exported_namespace=\"$namespace\"} == 1, \"svc\", \"$1\", \"name\", \"(.*)\")",
          "legendFormat": "{{name}}: {{phase}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storefront rollout replicas (available / updated / desired)",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rollout_info_replicas_available{exported_namespace=\"$namespace\",name=\"storefront\"}",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rollout_info_replicas_updated{exported_namespace=\"$namespace\",name=\"storefront\"}",
          "legendFormat": "updated"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rollout_info_replicas_desired{exported_namespace=\"$namespace\",name=\"storefront\"}",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "type": "row",
      "title": "RED \u2014 request rate / errors / latency (OTLP app metrics)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "id": 30
    },
    {
      "type": "text",
      "title": "About these panels",
      "id": 31,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "mode": "markdown",
        "content": "RED metrics from the shop's OpenTelemetry SDK via the OTLP spoke. Since ADR-100, Mimir translates OTLP metrics to the Prometheus convention on ingest, so they carry `http_server_request_duration_seconds*` + `k8s_namespace_name` \u2014 identical to Beyla/remote-write \u2014 and one query works regardless of delivery path. Per-service breakdown is the `job` label (`alpha-shop/shop-<svc>`; OTLP's service identifier). Autoscaling + progressive-delivery panels above use kube-state-metrics / Argo Rollouts (`namespace`/`exported_namespace`)."
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by service (req/s)",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1
          },
          "unit": "reqps",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job)(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error ratio (5xx)",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job)(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\",http_response_status_code=~\"5..\"}[5m])) / sum by (job)(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "id": 34,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job)(rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}