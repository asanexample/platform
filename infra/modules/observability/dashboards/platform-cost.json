{
  "uid": "platform-cost",
  "title": "Platform Cost",
  "tags": ["platform", "cost", "opencost"],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "5m",
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "changes(kube_deployment_metadata_generation[2m]) > 0",
        "iconColor": "blue",
        "name": "Deploys",
        "step": "1m",
        "tagKeys": "namespace,deployment",
        "textFormat": "{{namespace}}/{{deployment}}",
        "titleFormat": "Deploy"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster node cost ($/hr)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(node_total_hourly_cost)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Projected node cost ($/mo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(node_total_hourly_cost) * 730" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Load balancers ($/mo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kubecost_load_balancer_cost) * 730" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "NAT-gateway egress ($/mo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kubecost_network_nat_gateway_egress_cost) * 730" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost by namespace ($/mo, CPU+RAM allocation × node price)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(15, sum by (namespace) ( (container_cpu_allocation * on(node) group_left() node_cpu_hourly_cost) + (container_memory_allocation_bytes/1024/1024/1024 * on(node) group_left() node_ram_hourly_cost) ) * 730)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node cost ($/hr)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_total_hourly_cost", "legendFormat": "{{node}} ({{instance_type}})" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network egress cost ($/hr)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kubecost_network_nat_gateway_egress_cost)", "legendFormat": "NAT egress" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kubecost_network_internet_egress_cost)", "legendFormat": "Internet egress" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kubecost_network_zone_egress_cost)", "legendFormat": "Cross-zone egress" }
      ]
    }
  ]
}
